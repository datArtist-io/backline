
# Private monitor at /ops: comma-separated emails allowed to open it (everyone else gets a 404).
ADMIN_EMAILS=
# Optional: long random string. /api/health shows its per-service list only with
# `Authorization: Bearer <this>` (or to ADMIN_EMAILS); everyone else sees up or down.
HEALTH_TOKEN=
# Optional: Supabase secret (service) key, for account/trip/payment counts on /ops. Server only.
SUPABASE_SECRET_KEY=
