{
  "name": "backline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @backline/web",
    "build": "npm run build -w @backline/web",
    "start": "npm run start -w @backline/web",
    "test": "npm run test -w @backline/engine && npm run test -w @backline/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "node scripts/check.mjs",
    "check:locations": "node scripts/check-locations.mjs",
    "check:places": "node scripts/check-places.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.29",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=1000"
    ],
    "*": [
      "node scripts/check-secrets.mjs"
    ]
  }
}
