# Copy this file to apps/web/.env.local and fill in your keys.
# Never commit .env.local (it is git-ignored) and never paste keys into chats or screenshots.

# Qloo hackathon API
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# AI model for reasoning and writing. Any OpenAI-compatible provider.
# Nebius (default): https://api.tokenfactory.nebius.com/v1
# Groq:             https://api.groq.com/openai/v1
# NVIDIA build:    https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
LLM_MODEL_STRONG=nvidia/Nemotron-3-Ultra-550b-a55b
# Optional JSON merged into every model request, e.g. to switch reasoning off for thinking models:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Research, hotel prices and reading PDFs and photos: Claude with web search (first choice).
# Needs API credit; roughly $10 per 1,000 searches plus tokens. Tavily is an optional backup.
ANTHROPIC_API_KEY=
CLAUDE_SEARCH_MODEL=claude-haiku-5-5
# With no key (or no credit), research still works for free from Wikivoyage and Wikipedia.
# Set OSM_CONTACT_EMAIL so Wikimedia and OpenStreetMap know who to contact. WEB_SEARCH=off turns research off.
TAVILY_API_KEY=
# WEB_SEARCH_PROVIDER=claude   # or tavily, when both keys are set

# Speech-to-text (Whisper, auto-detects the language). Default provider: Groq.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Google and Apple sign-in (Supabase Auth). Same project URL as below; enable the providers
# in Supabase → Authentication → Providers, and add http://localhost:3000/join to the redirect allow-list.
NEXT_PUBLIC_SUPABASE_URL=

# Waitlist storage (Supabase). Run packages/db/migrations/0001_waitlist.sql first.
# Without these, local dev uses an in-memory list and production shows "opens soon".
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Waitlist confirmation emails (optional, via Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=

# Public site settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Acting on your behalf (optional). Without these the agent prepares emails and call scripts,
# and you send or call yourself.
# Emails: Resend, from an address on a domain you've verified in Resend. Replies go to the user.
ACTIONS_FROM_EMAIL=
# Phone calls: Vapi (vapi.ai). Create or import a phone number, then copy its id.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL=gpt-4o-mini

# Hotel booking and payment (LiteAPI). A sandbox key (sand_...) books test rooms and simulates payment.
# Get one free at https://dashboard.liteapi.travel
LITEAPI_API_KEY=

# Flight booking and payment (Duffel). A test token (duffel_test_...) books on Duffel's test airline; no money moves.
# Get one free at https://app.duffel.com
DUFFEL_API_KEY=

# Map tiles (optional). Default: OpenStreetMap's own tiles, fine for development and light demos.
# For heavier traffic use a keyed provider, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=© MapTiler
